{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lifeos/api --filter @lifeos/web dev",
    "build": "pnpm --filter @lifeos/api build && pnpm --filter @lifeos/web build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @lifeos/db migrate",
    "db:seed": "pnpm --filter @lifeos/db seed",
    "data:reset:all": "pnpm --filter @lifeos/db exec tsx ../../scripts/reset/reset-all.ts",
    "data:reset:task": "pnpm --filter @lifeos/db exec tsx ../../scripts/reset/reset-task.ts",
    "data:inspect": "pnpm --filter @lifeos/db exec tsx ../../scripts/inspect/status.ts",
    "data:inspect:task": "pnpm --filter @lifeos/db exec tsx ../../scripts/inspect/task-timeline.ts"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "globals": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
